# SITE_ADDRESS comes from .env, e.g. 65-108-1-2.sslip.io (resolves to 65.108.1.2): Caddy gets a Let's Encrypt
# certificate for it automatically. Use "http://:80" for a plain-HTTP test without a public IP.
{
	order rate_limit before reverse_proxy
}

{$SITE_ADDRESS} {
	encode zstd gzip

	# Per-IP limits on the expensive endpoints (HTTP 429 beyond them).
	rate_limit {
		zone ask {
			match {
				method POST
				path /api/plans/*/ask
			}
			key {remote_host}
			events {$RATE_ASK_PER_MIN:20}
			window 1m
		}
		zone analyze {
			match {
				method POST
				path /api/plans/*/analyze /api/plans/*/upload
			}
			key {remote_host}
			events {$RATE_ANALYZE_PER_MIN:6}
			window 1m
		}
	}

	request_body {
		max_size 50MB
	}

	reverse_proxy frontend:3000
}
