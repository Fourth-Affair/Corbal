# Copy to .env and fill in. .env is gitignored.
GEMINI_API_KEY=
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-or-publishable-key
NEXT_PUBLIC_SUPABASE_BUCKET=plans
SUPABASE_SERVICE_ROLE_KEY=your-service-role-secret

# Production (compose.prod.yaml, deploy/deploy.sh)
# Server IP for deploy/deploy.sh (then the IP argument can be left out)
DEPLOY_HOST=
# Default: <DEPLOY_HOST with dashes>.sslip.io, e.g. 65.108.1.2 -> 65-108-1-2.sslip.io
SITE_ADDRESS=
# Uncached Gemini questions per hour; beyond it the template answerer replies
GEMINI_MAX_PER_HOUR=300
# Per-IP limits in Caddy (HTTP 429 beyond): questions / uploads+analyses per minute
RATE_ASK_PER_MIN=20
RATE_ANALYZE_PER_MIN=6
# Uploads above this many pixels are downscaled before analysis (peak RAM ~1.7 GB + 0.27 GB per megapixel).
# 16000000 (~6 GB) suits a 16 GB server; use ~10000000 on 8 GB.
MAX_ANALYSIS_PIXELS=16000000
# Gemini model id for the answering agent (change it here when Google retires a model)
GEMINI_MODEL=gemini-3.8-flash
